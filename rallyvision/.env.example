# ---- AI insights (optional; without any key the app uses a deterministic mock) ----
# AI_PROVIDER=anthropic | gemini | mock   (default: auto -> anthropic, then gemini, then mock)
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- Shuttle tracking model (optional) ----
# URL of a TrackNetV3 (or TrackNetV2) ONNX export. When set, the UI offers the
# "TrackNet (neural)" engine in addition to the built-in classical tracker.
NEXT_PUBLIC_TRACKNET_ONNX_URL=

# ---- Remote GPU worker (optional) ----
# Base URL of the Modal worker in /worker. When set, "Cloud GPU" analysis is offered.
NEXT_PUBLIC_ML_WORKER_URL=
